{
  "name": "demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The project's demo video: one storyboard, voiced line by line, rendered with Remotion.",
  "scripts": {
    "demo": "tsx src/pipeline/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "advisories": "tsx src/pipeline/advisories.ts",
    "studio": "remotion studio src/index.ts"
  },
  "dependencies": {
    "@google/genai": "2.26.0",
    "@huggingface/transformers": "3.8.1",
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "kokoro-js": "1.2.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "global-agent": "4.1.3",
    "sharp": "0.35.5"
  }
