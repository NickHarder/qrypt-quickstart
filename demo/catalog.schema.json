                  "to_line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "highlight": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "required": [
                  "file",
                  "from_line",
                  "to_line"
                ],
                "additionalProperties": false,
                "description": "An excerpt of a real file in the repository, read when the cut is built, with some lines marked. At most 18 lines of at most 100 characters."
              }
            },
