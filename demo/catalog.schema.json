                  "take": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  },
                  "beat": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  },
                  "trim": {
                    "type": "object",
                    "properties": {
                      "head_seconds": {
                        "default": 0,
                        "type": "number",
                        "minimum": 0
