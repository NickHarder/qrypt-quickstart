                "required": [
                  "command",
                  "output_file"
                ],
                "additionalProperties": false,
                "description": "A command and its real output, revealed line by line. The output is read from a file the command wrote when it was run; it is never typed into the storyboard. At most 18 lines."
              }
            },
            "required": [
              "id",
              "lines",
              "component",
              "props"
            ],
            "additionalProperties": false
