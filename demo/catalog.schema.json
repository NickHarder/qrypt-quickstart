                    },
                    "pause_before_seconds": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 5
                    }
                  },
                  "required": [
                    "key",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "min_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 120
              },
              "component": {
                "type": "string",
