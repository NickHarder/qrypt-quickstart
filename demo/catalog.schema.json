                      "tail_seconds": {
                        "default": 0,
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false
                  },
                  "key_phrases": {
                    "default": [],
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60
                        },
                        "at_seconds": {
                          "type": "number",
                          "minimum": 0
                        },
                        "for_seconds": {
                          "default": 3,
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 10
                        }
                      },
                      "required": [
                        "text",
                        "at_seconds"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "take",
                  "beat"
                ],
                "additionalProperties": false,
                "description": "A beat of a real Playwright recording of the product. `take` and `beat` name a beat in beats.json; the take must be recorded first. Product footage is never generated."
              }
