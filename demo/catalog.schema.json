              "props": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "metrics": {
                    "minItems": 1,
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60
                        },
                        "source": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "scope": {
                          "type": "string",
                          "enum": [
                            "one user",
                            "load test",
                            "eval run",
                            "production"
                          ]
                        }
                      },
                      "required": [
                        "value",
                        "label",
                        "source",
                        "scope"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "metrics"
                ],
                "additionalProperties": false,
                "description": "One to four numbers. Each must say what it was measured on (scope) and where it comes from (source); both are shown on screen."
              }
