                      "minLength": 1
                    },
                    "style": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pause_before_seconds": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 5
                    }
                  },
                  "required": [
                    "key",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "min_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 120
              },
              "component": {
                "type": "string",
                "const": "Illustration"
              },
              "props": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "file"
                ],
                "additionalProperties": false,
                "description": "A generated or licensed still or clip, for a moment the product cannot show. It is always drawn with a tag that says illustration, and must be listed in media.lock.json."
