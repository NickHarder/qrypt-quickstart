    "target_seconds": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "style": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pause_before_seconds": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 5
                    }
                  },
                  "required": [
                    "key",
                    "text"
