  "required": [
    "title",
    "target_seconds",
    "scenes"
  ],
  "additionalProperties": false,
  "description": "A demo storyboard. Each scene names one catalog component and gives exactly the props that component declares; anything else is rejected. Also enforced: scene ids are unique; line keys are unique across the storyboard; a scene with no lines sets min_seconds. A scene lasts as long as its lines take to say."
}
