{
  "permissions": {
    "allow": [
      "Bash(make gate)",
      "Bash(make gate-*)",
      "Bash(make checks)",
      "Bash(make check C=*)",
      "Bash(make docs-index)",
      "Bash(make docs-find *)",
      "Bash(make docs-status)",
      "Bash(make look-ahead)",
      "Bash(make blockers)",
      "Bash(make blockers *)",
      "Bash(make skill-costs)",
      "Bash(make skill-costs *)",
      "Bash(make trace)",
      "Bash(make kit-files)",
      "Bash(make help)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud_start.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/skill_costs.py hook",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/stop_check.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
