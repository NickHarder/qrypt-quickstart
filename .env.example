# Copy to .env and fill in. Never commit .env.
#
# This one file holds every key and setting the project reads. Each layer reads it from the repository
# root, whatever directory a command runs in. A real environment variable wins over a line here.

# --- The Python service (src/qrypt_quickstart/config.py) ---
# Every setting is listed with the default the code uses; tests/test_env_example.py fails when
# the two drift apart. Leave a secret's value empty.

# development | staging | production
QRYPT_QUICKSTART_ENVIRONMENT=development
QRYPT_QUICKSTART_LOG_LEVEL=INFO
# The model provider's API key, for anything that calls the real model (a paid eval run, the service
# itself). The gate and the tests never need it.
QRYPT_QUICKSTART_MODEL_API_KEY=

# --- The quickstart snippets (quickstart/) ---
# Your Qrypt access token for the Entropy service. The snippets, the live check and the agent harness
# read it; the tests never do (they use the mock). Never commit it, never show it on screen.
QRYPT_API_KEY=
# Where the snippets send their request. Unset, they call Qrypt's endpoint; tests point it at the
# local mock (python -m qrypt_quickstart.mock_server).
# QRYPT_API_URL=http://127.0.0.1:8765/api/v1/quantum-entropy

# --- The demo video (demo/) ---
# The voice the final voice-over is made with (`make demo-voice`). Empty: Gemini when GEMINI_API_KEY is
# set and works, Kokoro (free, local, the draft voice too) when it is not. Or name one: gemini, kokoro.
# Another is a file beside demo/src/pipeline/voice/gemini.ts and an entry in final.ts.
DEMO_VOICE_PROVIDER=
# Where Kokoro keeps its model (about 90 MB, downloaded once); unset, ~/.cache/kokoro-js.
# KOKORO_CACHE_DIR=
# The Gemini API key for the final voice-over. Create one in Google AI Studio; a Gemini app
# subscription does not include API access. The draft voice needs no key.
GEMINI_API_KEY=
